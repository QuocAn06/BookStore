@model BookCatalogVM
@{
    ViewData["Title"] = "Book Store";
    var prevPage = Model.CurrentPage - 1;
    var nextPage = Model.CurrentPage + 1;
}

<h1 class="mb-4">Danh sách sách</h1>

<div class="row g-4">
    @foreach (var book in Model.Books)
    {
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                @if (!string.IsNullOrEmpty(book.ImageUrl))
                {
                    <img src="@book.ImageUrl" class="card-img-top" alt="@book.Title" style="height:200px; object-fit:cover;" />
                }
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@book.Title</h5>
                    <p class="text-muted mb-1">@book.Author</p>
                    <p class="small mb-2">@(book.Category?.Name ?? "—")</p>
                    <p class="fw-bold text-primary mb-3">@book.Price.ToString("N0") ₫</p>
                    <form asp-controller="Cart" asp-action="Add" method="post" class="mt-auto">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="bookId" value="@book.Id" />
                        <input type="hidden" name="quantity" value="1" />
                        <button type="submit" class="btn btn-success w-100">Thêm vào giỏ</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.Books.Count == 0)
{
    <p class="text-center text-muted mt-4">Chưa có sách nào.</p>
}

@if (Model.TotalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-page="@prevPage">Previous</a>
            </li>
            <li class="page-item disabled">
                <span class="page-link">Trang @Model.CurrentPage / @Model.TotalPages</span>
            </li>
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-page="@nextPage">Next</a>
            </li>
        </ul>
    </nav>
}