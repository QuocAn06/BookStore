@model BookCatalogVM
@{
    ViewData["Title"] = "Book Store";
    var prevPage = Model.CurrentPage - 1;
    var nextPage = Model.CurrentPage + 1;
    var hasFilter = !string.IsNullOrWhiteSpace(Model.Search)
        || (Model.CategoryId is > 0)
        || Model.MinPrice.HasValue
        || Model.MaxPrice.HasValue;
}

<h1 class="mb-4">Danh sách sách</h1>

<form method="get" asp-controller="Home" asp-action="Index" class="mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label" for="search">Tìm theo tiêu đề</label>
            <input id="search"
                   name="search"
                   class="form-control"
                   value="@Model.Search"
                   placeholder="Nhập tiêu đề..." />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="categoryId">Danh mục</label>
            <select id="categoryId"
                    name="categoryId"
                    class="form-select"
                    asp-items="Model.CategoryOptions"></select>
        </div>
        <div class="col-md-2">
            <label class="form-label" for="minPrice">Giá từ</label>
            <input id="minPrice"
                   name="minPrice"
                   type="number"
                   step="0.01"
                   min="0"
                   class="form-control"
                   value="@Model.MinPrice" />
        </div>
        <div class="col-md-2">
            <label class="form-label" for="maxPrice">Giá đến</label>
            <input id="maxPrice"
                   name="maxPrice"
                   type="number"
                   step="0.01"
                   min="0"
                   class="form-control"
                   value="@Model.MaxPrice" />
        </div>
        <div class="col-md-auto">
            <button type="submit" class="btn btn-primary">Lọc</button>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary ms-1">Xóa lọc</a>
        </div>
    </div>
</form>

<div class="row g-4">
    @foreach (var book in Model.Books)
    {
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                @if (!string.IsNullOrEmpty(book.ImageUrl))
                {
                    <a asp-controller="Book" asp-action="Details" asp-route-id="@book.Id">
                        <img src="@book.ImageUrl" class="card-img-top" alt="@book.Title" style="height:200px; object-fit:cover;" />
                    </a>
                }
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">
                        <a asp-controller="Book"
                           asp-action="Details"
                           asp-route-id="@book.Id"
                           class="text-decoration-none text-dark">
                            @book.Title
                        </a>
                    </h5>
                    <p class="text-muted mb-1">@book.Author</p>
                    <p class="small mb-2">@(book.Category?.Name ?? "—")</p>
                    <p class="fw-bold text-primary mb-3">@book.Price.ToString("N0") ₫</p>
                    <div class="mt-auto d-grid gap-2">
                        <a asp-controller="Book"
                           asp-action="Details"
                           asp-route-id="@book.Id"
                           class="btn btn-outline-primary">
                            Xem chi tiết
                        </a>
                        <form asp-controller="Cart" asp-action="Add" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="bookId" value="@book.Id" />
                            <input type="hidden" name="quantity" value="1" />
                            <button type="submit" class="btn btn-success w-100">Thêm vào giỏ</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.Books.Count == 0)
{
    <p class="text-center text-muted mt-4">
        @(hasFilter ? "Không tìm thấy sách phù hợp." : "Chưa có sách nào.")
    </p>
}

@if (Model.TotalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@prevPage"
                   asp-route-search="@Model.Search"
                   asp-route-categoryId="@Model.CategoryId"
                   asp-route-minPrice="@Model.MinPrice"
                   asp-route-maxPrice="@Model.MaxPrice">Previous</a>
            </li>
            <li class="page-item disabled">
                <span class="page-link">Trang @Model.CurrentPage / @Model.TotalPages</span>
            </li>
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@nextPage"
                   asp-route-search="@Model.Search"
                   asp-route-categoryId="@Model.CategoryId"
                   asp-route-minPrice="@Model.MinPrice"
                   asp-route-maxPrice="@Model.MaxPrice">Next</a>
            </li>
        </ul>
    </nav>
}