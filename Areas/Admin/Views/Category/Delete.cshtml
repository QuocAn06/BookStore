@model BookStore.Models.ViewModels.CategoryDeleteVM

@{
    ViewData["Title"] = "Delete Category";
}

<div class="container mt-4">
    <h2>Delete Category</h2>
    <hr />

    @if (Model.CanDelete)
    {
        <div class="alert alert-warning">
            Are you sure you want to delete this category?
        </div>
    }
    else
    {
        <div class="alert alert-danger">
            Cannot delete this category because it contains <strong>@Model.BookCount</strong> book(s).
            Remove or reassign those books first.
        </div>
    }

    <dl class="row">
        <dt class="col-sm-2">Id</dt>
        <dd class="col-sm-10">@Model.Id</dd>

        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Description</dd>

        <dt class="col-sm-2">Books</dt>
        <dd class="col-sm-10">@Model.BookCount</dd>
    </dl>

    <form asp-area="Admin" asp-controller="Category" asp-action="Delete" method="post">
        <input asp-for="Id" type="hidden" />
        <button type="submit" class="btn btn-danger" disabled="@(Model.CanDelete ? null : "disabled")">Delete</button>
        <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>