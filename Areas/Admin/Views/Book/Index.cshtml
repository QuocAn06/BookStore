@model BookStore.Models.ViewModels.AdminBooksIndexVM

@{
    ViewData["Title"] = "Book List";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Book List</h2>
        <a asp-area="Admin" asp-controller="Book" asp-action="Create" class="btn btn-primary">Create New</a>
    </div>

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success">@TempData["success"]</div>
    }

    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger">@TempData["error"]</div>
    }

    <form method="get" asp-area="Admin" asp-controller="Book" asp-action="Index" class="mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label" for="title">Search title</label>
                <input id="title" name="title" class="form-control"
                       value="@Model.TitleSearch" placeholder="Contains..." />
            </div>
            <div class="col-md-4">
                <label class="form-label" for="categoryId">Category</label>
                <select id="categoryId" name="categoryId" class="form-select"
                        asp-items="Model.CategoryOptions"></select>
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-primary">Apply</button>
                <a asp-area="Admin" asp-controller="Book" asp-action="Index" class="btn btn-outline-secondary ms-1">Clear</a>
            </div>
        </div>
    </form>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th style="width:70px;">Id</th>
                <th>Image</th>
                <th>Title</th>
                <th>Author</th>
                <th>Category</th>
                <th>Price</th>
                <th>Stock</th>
                <th style="width:280px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Books.Any())
            {
                foreach (var item in Model.Books)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="Book Image" style="width:60px;height:80px;object-fit:cover;" />
                            }
                        </td>
                        <td>@item.Title</td>
                        <td>@item.Author</td>
                        <td>@item.Category?.Name</td>
                        <td>@item.Price.ToString("N2")</td>
                        <td>@item.Stock</td>
                        <td>
                            <a asp-area="Admin" asp-controller="Book" asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Details</a>
                            <a asp-area="Admin" asp-controller="Book" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edit</a>
                            <a asp-area="Admin" asp-controller="Book" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center">No books found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>